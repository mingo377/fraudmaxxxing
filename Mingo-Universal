-- ---------- COMBAT / AIM ----------
reg("Aimbot (Basic Toggle)", "Combat", function()
    if getgenv().mingo_aim then
        getgenv().mingo_aim = false
        notify("aimbot off")
        return
    end
    getgenv().mingo_aim = true
    local cam = Workspace.CurrentCamera
    getgenv().mingo_aimConn = RunService.RenderStepped:Connect(function()
        if not getgenv().mingo_aim then return end
        local closest, dist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local h = p.Character:FindFirstChildWhichIsA("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if h and hrp and h.Health > 0 then
                    local _, on = cam:WorldToViewportPoint(hrp.Position)
                    local d = (hrp.Position - cam.CFrame.Position).Magnitude
                    if on and d < dist then closest, dist = hrp, d end
                end
            end
        end
        if closest then
            cam.CFrame = CFrame.new(cam.CFrame.Position, closest.Position)
        end
    end)
    notify("aimbot on")
end)
reg("Kill Aura Toggle", "Combat", function()
    if getgenv().mingo_ka then
        getgenv().mingo_ka = false
        notify("kill aura off")
        return
    end
    getgenv().mingo_ka = true
    getgenv().mingo_kaConn = RunService.Heartbeat:Connect(function()
        if not getgenv().mingo_ka then return end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local h = p.Character:FindFirstChildWhichIsA("Humanoid")
                local thrp = p.Character:FindFirstChild("HumanoidRootPart")
                if h and thrp and h.Health > 0 then
                    if (thrp.Position - hrp.Position).Magnitude < 15 then
                        h.Health = 0
                    end
                end
            end
        end
    end)
    notify("kill aura on")
end)

