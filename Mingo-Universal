reg("Infinite Jump Toggle", "Movement", function()
    if getgenv().mingo_infjump then
        getgenv().mingo_infjump = false
        notify("inf jump off")
        return
    end
    getgenv().mingo_infjump = true
    local conn
    conn = UserInputService.JumpRequest:Connect(function()
        if getgenv().mingo_infjump and LP.Character then
            local h = LP.Character:FindFirstChildWhichIsA("Humanoid")
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
    getgenv().mingo_infjumpConn = conn
    notify("inf jump on")
end)
reg("Fly (default speed)", "Movement", function()
    local h = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
    if not h then return end
    local root = LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if getgenv().mingo_flyConn then
        getgenv().mingo_flyConn:Disconnect()
        getgenv().mingo_flyConn = nil
        notify("fly off")
        return
    end
    h.PlatformStand = true
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 1e4
    bg.CFrame = root.CFrame
    bg.Parent = root
    local cam = Workspace.CurrentCamera
    getgenv().mingo_flyConn = RunService.RenderStepped:Connect(function()
        if not root.Parent then return end
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        bv.Velocity = dir * 60
        bg.CFrame = cam.CFrame
    end)
    notify("fly on — WASD, space/ctrl")
end)
