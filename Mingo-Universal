local function makeButton(entry, layoutIndex)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 26)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    btn.BorderSizePixel = 0
    btn.Text = "  [" .. entry.cat .. "]  " .. entry.name
    btn.TextColor3 = Color3.fromRGB(220, 220, 230)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = layoutIndex
    btn.ZIndex = 2
    btn.Parent = scroll
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = btn
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    end)
    btn.MouseButton1Click:Connect(function()
        local ok, err = pcall(entry.fn)
        if not ok then notify("error: " .. tostring(err)) end
    end)
    return btn
end

local function rebuild(filter)
    for _, v in ipairs(scroll:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    local f = (filter or ""):lower()
    local idx = 0
    for _, entry in ipairs(registry) do
        local match = f == ""
            or entry.name:lower():find(f, 1, true)
            or entry.cat:lower():find(f, 1, true)
        if match then
            idx = idx + 1
            makeButton(entry, idx)
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 5)
    statusLabel.Text = "mingo stamped | " .. idx .. " / " .. #registry .. " entries"
end

