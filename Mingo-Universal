local function makeBox(plr)
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if hrp:FindFirstChild("mingoBox") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "mingoBox"
    hl.FillColor = plr.Team and plr.Team.TeamColor.Color or Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
    hl.Parent = char
end
reg("ESP — Players", "Visual", function()
    if getgenv().mingo_esp then
        getgenv().mingo_esp = false
        for _, v in ipairs(Players:GetPlayers()) do
            if v.Character and v.Character:FindFirstChild("mingoBox") then
                v.Character.mingoBox:Destroy()
            end
        end
        notify("esp off")
        return
    end
    getgenv().mingo_esp = true
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LP then makeBox(v) end
    end
    getgenv().mingo_espConn = Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function()
            if getgenv().mingo_esp then makeBox(p) end
        end)
    end)
    notify("esp on")
end)
