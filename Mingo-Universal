reg("Apply Headless", "Character", function()
    if LP.Character then
        local h = LP.Character:FindFirstChild("Head")
        if h then h.Transparency = 1 end
        local hm = LP.Character:FindFirstChild("Humanoid")
        if hm then 
            if hm.RigType == Enum.HumanoidRigType.R15 then
                hm.HipHeight = 0.2 
            end
        end
        notify("headless applied (local)")
    end
end)
reg("Apply Korblox (Right Leg)", "Character", function()
    if LP.Character then
        local rl = LP.Character:FindFirstChild("Right Leg") or LP.Character:FindFirstChild("RightLowerLeg")
        if rl then
            rl.Transparency = 1
            local mesh = rl:FindFirstChildOfClass("SpecialMesh")
            if mesh then mesh:Destroy() end
            local kpart = Instance.new("Part")
            kpart.Name = "KorbloxLeg"
            kpart.Size = Vector3.new(1, 1.2, 1)
            kpart.Transparency = 1
            kpart.CanCollide = false
            kpart.Massless = true
            kpart.CFrame = rl.CFrame
            kpart.Parent = LP.Character
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = rl
            weld.Part1 = kpart
            weld.Parent = kpart
        end
        notify("korblox applied (local)")
    end
end)
reg("Reset Character Appearance", "Character", function()
    for _, v in ipairs(LP.Character:GetDescendants()) do
        if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
            v.Transparency = 0
