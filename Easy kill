local draggingButton = false
local movedButton = false
local dragStart = nil
local startPosition = nil
local activeTouch = nil

local function isPointerInput(input)
    return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
end

openButton.InputBegan:Connect(function(input)
    if buttonLocked or not isPointerInput(input) then return end
    draggingButton = true
    movedButton = false
    dragStart = input.Position
    startPosition = openButton.Position
    if input.UserInputType == Enum.UserInputType.Touch then activeTouch = input end
end)

UIS.InputChanged:Connect(function(input)
    if not draggingButton or buttonLocked then return end
    local movement = input.UserInputType == Enum.UserInputType.MouseMovement or input == activeTouch
    if not movement then return end
    local delta = input.Position - dragStart
    if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then movedButton = true end
    if movedButton then
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize
        local x = startPosition.X.Offset + delta.X
        local y = startPosition.Y.Offset + delta.Y
        if viewport then
            x = math.clamp(x, 0, math.max(0, viewport.X - 112))
            y = math.clamp(y, 0, math.max(0, viewport.Y - 39))
        end
        openButton.Position = UDim2.fromOffset(x, y)
        lockButton.Position = UDim2.fromOffset(x, math.clamp(y + 44, 0, math.max(0, (viewport and viewport.Y or 600) - 31)))
    end
end)

