        if not pickerFrame or not pickerFrame.Parent then return end
        for _, child in ipairs(pickerFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= player then
                local targetPlayer = target
                local btn = make("TextButton", {
                    Size = UDim2.new(1, -3, 0, 31),
                    BackgroundColor3 = selectedPlayer == targetPlayer and theme.accent or theme.card,
                    Text = "  " .. targetPlayer.DisplayName .. "  (@" .. targetPlayer.Name .. ")",
                    TextColor3 = theme.text,
                    TextSize = 10,
                    Font = Enum.Font.GothamSemibold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Active = true,
                    Selectable = true,
                    ZIndex = 7,
                }, pickerFrame)
                round(btn, 6)
                btn.Activated:Connect(function()
                    selectedPlayer = targetPlayer
                    pickerRefresh()
                end)
            end
        end
    end
    pickerRefresh()
end

