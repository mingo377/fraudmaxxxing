    sidebar.BackgroundColor3 = theme.panel
    openButton.BackgroundColor3 = theme.accent
    lockButton.BackgroundColor3 = theme.card
    content.ScrollBarImageColor3 = theme.accent
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextBox") then
            if obj:GetAttribute("Muted") then obj.TextColor3 = theme.muted else obj.TextColor3 = theme.text end
        elseif obj:IsA("UIStroke") then
            obj.Color = theme.accent
        end
    end
    for name, btn in pairs(tabButtons) do
        btn.BackgroundColor3 = name == activeTab and theme.accent or theme.panel
