        Position = UDim2.new(1, -44, 0.5, -10),
        BackgroundColor3 = toggleStates[label] and theme.accent or Color3.fromRGB(70, 69, 83),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 7,
    }, row)
    round(track, 12)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = toggleStates[label] and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 8,
    }, track)
    round(knob, 10)
    track.Activated:Connect(function()
        toggleStates[label] = not toggleStates[label]
        local on = toggleStates[label]
        if toggleHandlers[label] then toggleHandlers[label](on) end
        tween(track, { BackgroundColor3 = on and theme.accent or Color3.fromRGB(70, 69, 83) })
        tween(knob, { Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) })
    end)
end

local function numberSetting(label, default, minimum, maximum)
    local row = newCard(42)
    local title = addText(row, label, 11, UDim2.fromOffset(10, 0), UDim2.new(1, -105, 1, 0))
    title.Font = Enum.Font.GothamSemibold
    local box = make("TextBox", {
        Position = UDim2.new(1, -84, 0.5, -13),
        Size = UDim2.fromOffset(76, 27),
        BackgroundColor3 = theme.bg,
        Text = numberValues[label] or tostring(default),
        PlaceholderText = tostring(default),
        TextColor3 = theme.text,
        PlaceholderColor3 = theme.muted,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        ClearTextOnFocus = false,
        Active = true,
        Selectable = true,
        ZIndex = 7,
    }, row)
    round(box, 7)
    stroke(box, theme.accent, 0.45)
    box.FocusLost:Connect(function()
        local value = tonumber(box.Text)
        if value then
            value = math.clamp(value, minimum, maximum)
            numberValues[label] = tostring(value)
            box.Text = tostring(value)
        else
            box.Text = numberValues[label] or tostring(default)
        end
    end)
end

local function optionGroup(title, options, default, callback)
    heading(title)
    local group = newCard(#options * 32 + 8)
    local buttons = {}
    for i, option in ipairs(options) do
        local btn = make("TextButton", {
            Position = UDim2.fromOffset(5, 4 + (i - 1) * 32),
            Size = UDim2.new(1, -10, 0, 27),
            BackgroundColor3 = option == default and theme.accent or theme.card,
            Text = (option == default and "✓  " or "   ") .. option,
            TextColor3 = theme.text,
            TextSize = 10,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            Active = true,
            Selectable = true,
            ZIndex = 7,
        }, group)
        round(btn, 6)
        buttons[option] = btn
        btn.Activated:Connect(function()
            for name, b in pairs(buttons) do
                local selected = name == option
                b.Text = (selected and "✓  " or "   ") .. name
                tween(b, { BackgroundColor3 = selected and theme.accent or theme.card })
            end
            callback(option)
        end)
    end
end

