local function setOpen(state)
    if busy then return end
    busy = true
    isOpen = state
    if state then
        window.Visible = true
        local s = getWindowSize()
        window.Size = UDim2.fromOffset(s.X * 0.94, s.Y * 0.94)
        tween(window, { Size = UDim2.fromOffset(s.X, s.Y) }, 0.2)
        openButton.Text = "✦  MENU"
        task.wait(0.21)
    else
        local s = getWindowSize()
        local t = tween(window, { Size = UDim2.fromOffset(s.X * 0.94, s.Y * 0.94) }, 0.13)
        t.Completed:Wait()
        window.Visible = false
        window.Size = UDim2.fromOffset(s.X, s.Y)
        openButton.Text = "OPEN MENU"
    end
    busy = false
end

