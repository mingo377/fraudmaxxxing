-- Target Selection Helper
local cachedTarget = nil
local lastTargetFind = 0

local function getTarget()
    local now = os.clock()
    if chosenTargetMode == "Select Player" then
        return selectedPlayer and selectedPlayer.Character
    end
    if chosenTargetMode == "Random Target" and cachedTarget and cachedTarget.Parent and (now - lastTargetFind < 2) then
        return cachedTarget
    end

    local bestTarget = nil
    local shortestDist = math.huge
    local lowestHp = math.huge
    local candidates = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and (player.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude) or 0
                if chosenTargetMode == "Nearest" then
                    if dist < shortestDist then
                        shortestDist = dist
                        bestTarget = p.Character
                    end
                elseif chosenTargetMode == "Lowest HP" then
                    if hum.Health < lowestHp then
                        lowestHp = hum.Health
                        bestTarget = p.Character
                    end
                elseif chosenTargetMode == "Random Target" then
                    table.insert(candidates, p.Character)
                end
            end
        end
    end

    if chosenTargetMode == "Random Target" and #candidates > 0 then
        bestTarget = candidates[math.random(1, #candidates)]
    end

    cachedTarget = bestTarget
    lastTargetFind = now
    return bestTarget
end

local function setCharacterInvisible(invisible)
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = invisible and 1 or 0
        elseif part:IsA("Decal") then
            part.Transparency = invisible and 1 or 0
        end
    end
end

local function setCharacterNoClip(noclip)
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not noclip
        end
    end
end

local combatAngle = 0

-- Main Loop
RunService.Heartbeat:Connect(function(dt)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera

    if hum and toggleStates["Walkspeed"] then
        if not defaultSpeed then defaultSpeed = hum.WalkSpeed end
        hum.WalkSpeed = tonumber(numberValues.Walkspeed) or 16
    end

    if toggleStates["Decorative effects"] then
        windowStroke.Transparency = 0.2 + 0.3 * (math.sin(os.clock() * 2) + 1) / 2
    else
        windowStroke.Transparency = 0.2
    end

    local targetChar = getTarget()

    -- [FIXED] Spectate Target Handler
    if toggleStates["Spectate Target"] and targetChar then
        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        if targetHum then
            cam.CameraSubject = targetHum
        end
    else
        if hum and cam.CameraSubject ~= hum then
            cam.CameraSubject = hum
        end
    end

    if hrp then
        -- Clean Anti-Void Protection (Teleports you back to surface if you fall too low)
        if hrp.Position.Y < -20 then
            hrp.CFrame = CFrame.new(hrp.Position.X, 15, hrp.Position.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    -- Combat Logic (Easy Kill)
    if toggleStates["Easy kill"] and hrp then
        setCharacterInvisible(true)
        if chosenMode == "Under" then
            setCharacterNoClip(true)
        else
            setCharacterNoClip(false)
        end

        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local targetHrp = targetChar.HumanoidRootPart
            local dist = tonumber(numberValues["Distance"]) or 10
            local speed = tonumber(numberValues["Orbit Speed"]) or 5

            combatAngle = combatAngle + dt * speed
            local targetPos = targetHrp.Position
            local newCFrame

            if chosenMode == "Orbit" then
                local offsetPos = targetPos + Vector3.new(math.cos(combatAngle) * dist, 2, math.sin(combatAngle) * dist)
                newCFrame = CFrame.lookAt(offsetPos, targetPos)
            elseif chosenMode == "Under" then
                local pos = targetPos - Vector3.new(0, dist, 0)
                newCFrame = CFrame.lookAt(pos, targetPos)
            elseif chosenMode == "Up" then
                local pos = targetPos + Vector3.new(0, dist, 0)
                newCFrame = CFrame.lookAt(pos, targetPos)
            elseif chosenMode == "Behind" then
                local pos = targetPos - (targetHrp.CFrame.LookVector * dist) + Vector3.new(0, 2, 0)
                newCFrame = CFrame.lookAt(pos, targetPos)
            end

            if newCFrame then
                hrp.CFrame = newCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    else
        setCharacterInvisible(false)
        setCharacterNoClip(false)
    end
end)

