local function tryTeleport(fn)
    local ok = pcall(fn)
    return ok and "Teleporting..." or "Failed (Studio?)"
end

serverActions = {
    ["Serverhop"] = function()
        return tryTeleport(function() TeleportService:Teleport(game.PlaceId, player) end)
    end,
    ["Rejoin Server"] = function()
        return tryTeleport(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player) end)
    end,
    ["Join Small Server"] = function()
        local rf = ReplicatedStorage:FindFirstChild("GetSmallServer")
        if not rf then return "Needs GetSmallServer remote" end
        local ok, id = pcall(function() return rf:InvokeServer() end)
        if ok and id then
            return tryTeleport(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, id, player) end)
        end
        return "No small server found"
    end,
}

local function buildPage(name)
