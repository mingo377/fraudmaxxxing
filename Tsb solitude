local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")

-- Use CoreGui if available, otherwise fallback to PlayerGui
local parentGui = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")

-- Remove old GUI if re-executed
if parentGui:FindFirstChild("SolitudeSimpleGui") then
    parentGui.SolitudeSimpleGui:Destroy()
end

-- 1. Create Main ScreenGui Container
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SolitudeSimpleGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = parentGui

-- 2. Create Main Frame (Menu Box)
local frame = Instance.new("Frame")
frame.Name = "MainFrame"
frame.Size = UDim2.new(0, 220, 0, 160)
frame.Position = UDim2.new(0.05, 0, 0.3, 0) -- Top-left area of screen
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true -- Allows you to drag the menu around on mobile
frame.Parent = screenGui

-- Rounded corners for the menu
local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 8)
frameCorner.Parent = frame

-- Title Bar
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Text = "Solitude | Dash Helper"
title.TextSize = 14
title.Font = Enum.Font.SourceSansBold
title.Parent = frame

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 8)
titleCorner.Parent = title

-- 3. Create Toggle Button
local toggleButton = Instance.new("TextButton")
toggleButton.Name = "ToggleButton"
toggleButton.Size = UDim2.new(0.85, 0, 0, 35)
toggleButton.Position = UDim2.new(0.075, 0, 0.3, 0)
toggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40) -- Red (OFF)
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.Text = "Dash Helper: OFF"
toggleButton.TextSize = 14
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.Parent = frame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 6)
btnCorner.Parent = toggleButton

-- Toggle Logic
local dashEnabled = false
toggleButton.MouseButton1Click:Connect(function()
    dashEnabled = not dashEnabled
    if dashEnabled then
        toggleButton.Text = "Dash Helper: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 40) -- Green (ON)
        print("Dash Helper Enabled")
    else
        toggleButton.Text = "Dash Helper: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40) -- Red (OFF)
        print("Dash Helper Disabled")
    end
end)

-- 4. Create Simple Slider (Delay Setting)
local sliderLabel = Instance.new("TextLabel")
sliderLabel.Size = UDim2.new(0.85, 0, 0, 20)
sliderLabel.Position = UDim2.new(0.075, 0, 0.6, 0)
sliderLabel.BackgroundTransparency = 1
sliderLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
sliderLabel.Text = "Magnet Delay: 0.1s"
sliderLabel.TextSize = 12
sliderLabel.Font = Enum.Font.SourceSans
sliderLabel.Parent = frame

local sliderBg = Instance.new("TextButton")
sliderBg.Name = "SliderBg"
sliderBg.Size = UDim2.new(0.85, 0, 0, 15)
sliderBg.Position = UDim2.new(0.075, 0, 0.78, 0)
sliderBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
sliderBg.Text = ""
sliderBg.AutoButtonColor = false
sliderBg.Parent = frame

local sliderFill = Instance.new("Frame")
sliderFill.Size = UDim2.new(0.1, 0, 1, 0) -- Default 0.1s
sliderFill.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
sliderFill.BorderSizePixel = 0
sliderFill.Parent = sliderBg

local currentDelay = 0.1
sliderBg.MouseButton1Down:Connect(function()
    local mouse = LocalPlayer:GetMouse()
    local relativeX = math.clamp(mouse.X - sliderBg.AbsolutePosition.X, 0, sliderBg.AbsoluteSize.X)
    local percentage = relativeX / sliderBg.AbsoluteSize.X
    
    currentDelay = math.floor((percentage) * 100) / 100 -- Rounded delay
    sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    sliderLabel.Text = "Magnet Delay: " .. tostring(currentDelay) .. "s"
    print("Delay set to:", currentDelay)
end)

print("Custom UI loaded successfully!")
