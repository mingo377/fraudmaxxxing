---------------------------------------------------------
-- TSB FRONT-DASH MAGNET LOGIC
---------------------------------------------------------
local magnetEnabled = false
local scriptDelay = 0.1 -- Controlled by slider or textbox (0.1 to 2.0s)
local isTweening = false
local lastDashTime = 0

-- Function to find nearest target
local function getNearestTarget()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then nil end
    
    local nearest = nil
    local shortestDistance = math.huge
    
    for _, obj in pairs(workspace:GetChildren()) do
        if obj ~= character and obj:FindFirstChild("HumanoidRootPart") and obj:FindFirstChild("Humanoid") then
            if obj.Humanoid.Health > 0 then
                local dist = (character.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
                if dist < shortestDistance and dist <= 75 then
                    shortestDistance = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

-- Perform the Tween Magnet
local function performMagnet()
    if isTweening then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local target = getNearestTarget()
    if target and target:FindFirstChild("HumanoidRootPart") then
        isTweening = true
        
        -- Respect the delay property specified by slider/textbox
        if scriptDelay > 0 then
            task.wait(scriptDelay)
        end
        
        local rootPart = character.HumanoidRootPart
        local targetRoot = target.HumanoidRootPart
        
        -- Target Position: Right in front/on top of target torso
        local destination = targetRoot.CFrame * CFrame.new(0, 2, -1)
        
        -- Smooth Tween Glide
        local tweenInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = destination})
        
        tween:Play()
        tween.Completed:Wait()
        
        task.wait(0.3)
        isTweening = false
    end
end

-- Bulletproof Front-Dash Detection (Speed Spike + Forward Movement Check)
RunService.RenderStepped:Connect(function()
    if not magnetEnabled or isTweening then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Humanoid") then return end
    
    local rootPart = character.HumanoidRootPart
    local humanoid = character.Humanoid
    
    -- TSB dash creates a sharp speed spike over 28 studs/s
    local horizontalSpeed = Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z).Magnitude
    
    if horizontalSpeed > 28 then
        local moveDir = humanoid.MoveDirection
        local lookVec = rootPart.CFrame.LookVector
        
        -- Check if moving FORWARD (Front Dash only. Side/Back dashes will output a negative or low dot product)
        if moveDir.Magnitude > 0 and moveDir:Dot(lookVec) > 0.4 then
            if tick() - lastDashTime > 0.5 then
                lastDashTime = tick()
                task.spawn(performMagnet)
            end
        end
    end
end)

