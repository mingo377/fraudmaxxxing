local function updateDelay(val)
    scriptDelay = math.clamp(tonumber(val) or 0.1, 0.1, 2.0)
    delayTextBox.Text = tostring(scriptDelay)
    local pct = (scriptDelay - 0.1) / (2.0 - 0.1)
    delaySliderFill.Size = UDim2.new(pct, 0, 1, 0)
end

delayTextBox.FocusLost:Connect(function() updateDelay(delayTextBox.Text) end)
