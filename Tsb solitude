-- Load working UI Library
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/7GrandDadPGN/VapeV4ForRoblox/main/CustomModules/6872274481.lua"))()

-- If you prefer standard Orion, use this alternative direct mirror:
-- local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/jensonhirst/Orion/main/source'))()

local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/jensonhirst/Orion/main/source'))()

-- Create Window
local Window = OrionLib:MakeWindow({
    Name = "Solitude | Dash Helper",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "SolitudeConfig"
})

-- Create Tab
local Tab = Window:MakeTab({
    Name = "Main Controls",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- Add Toggle
Tab:AddToggle({
    Name = "Dash Helper Enabled",
    Default = false,
    Callback = function(Value)
        print("Dash helper toggled:", Value)
    end    
})

-- Add Slider
Tab:AddSlider({
    Name = "Dash Delay",
    Min = 0,
    Max = 1,
    Default = 0.1,
    Increment = 0.05,
    ValueName = "Seconds",
    Callback = function(Value)
        print("Delay set to:", Value)
    end    
})

OrionLib:Init()
