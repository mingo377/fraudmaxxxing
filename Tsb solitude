-- 1. Print test to confirm execution
print("Solitude script started!")

-- 2. Load the Orion UI Library
local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Orion/main/source'))()

-- 3. Create the Window Menu
local Window = OrionLib:MakeWindow({
    Name = "Solitude Dash Helper",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "SolitudeConfig"
})

-- 4. Create a Tab
local Tab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- 5. Add a Toggle
Tab:AddToggle({
    Name = "Solitude Dash Helper",
    Default = false,
    Callback = function(Value)
        print("Dash helper toggled:", Value)
    end    
})

-- 6. Add a Slider for Delay
Tab:AddSlider({
    Name = "Magnet Delay",
    Min = 0,
    Max = 1,
    Default = 0.1,
    Increment = 0.05,
    ValueName = "Seconds",
    Callback = function(Value)
        print("Delay set to:", Value)
    end    
})

-- Initialize UI
OrionLib:Init()
