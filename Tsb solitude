-- Target Finder from workspace.Live[span_6](start_span)[span_6](end_span)
local function getTargetByName(name)
    local liveFolder = workspace:FindFirstChild("Live")
    if not liveFolder then return nil end
    for _, obj in ipairs(liveFolder:GetChildren()) do
        if obj.Name == name and obj:FindFirstChild("HumanoidRootPart") then
            return obj
        end
    end
    return nil
end

-- Exact KittyWare Loop Dash Implementation[span_7](start_span)[span_7](end_span)
local function executeKittyWareLoopDash(targetModel, targetRoot)
    if isExecuting then return end
    isExecuting = true
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        isExecuting = false
        return 
    end
    
    local communicate = character:FindFirstChild("Communicate")
    local rootPart = character.HumanoidRootPart
    
    if scriptDelay > 0 then
        task.wait(scriptDelay)
    end
    
    -- 1. Fire Front Dash via TSB Remote[span_8](start_span)[span_8](end_span)
    if communicate then
        communicate:FireServer(frontDashData)
    end
    
    -- 2. Execute KittyWare Loop Arc Trajectory via RenderStepped[span_9](start_span)[span_9](end_span)
    local startTime = tick()
    local duration = 0.35
    local connection
    
    connection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local alpha = elapsed / duration
        
        if alpha >= 1 or not targetRoot.Parent or not rootPart.Parent then
            if connection then connection:Disconnect() end
            isExecuting = false
            return
        end
        
        -- Smooth orbital arc calculation around target
        local angle = alpha * math.pi * 1.75
        local radius = 30
        local offsetX = math.cos(angle) * radius
        local offsetZ = math.sin(angle) * radius
        
        local targetPos = targetRoot.Position
        local newPos = targetPos + Vector3.new(offsetX, 1.5, offsetZ)
        
        -- Pivot character smoothly while facing target[span_10](start_span)[span_10](end_span)
        rootPart.CFrame = CFrame.new(newPos, targetPos)
    end)
end

-- Automatic Animation Listener Hook (Directly from KittyWare source)[span_11](start_span)[span_11](end_span)
local function setupKittyWareHooks(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    
    local animator = humanoid:WaitForChild("Animator", 5)
    if not animator then return end
    
    animator.AnimationPlayed:Connect(function(track)
        if not magnetEnabled or isExecuting then return end
        
        local anim = track.Animation
        if not anim then return end
        
        local animId = anim.AnimationId
        -- Check if the played animation matches TSB M1 landing animations[span_12](start_span)[span_12](end_span)
        if animId == "rbxassetid://" .. animIdHit1 or animId == "rbxassetid://" .. animIdHit2 then
            local lastHitAttr = char:GetAttribute("LastM1Hitted")
            if not lastHitAttr then return end
            
            -- Extract target name from attribute string format[span_13](start_span)[span_13](end_span)
            local targetName = lastHitAttr:match("^(.-);;")
            if not targetName then return end
            
            local targetModel = getTargetByName(targetName)
            if targetModel and targetModel:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - targetModel.HumanoidRootPart.Position).Magnitude
                if dist <= scriptRange then
                    task.spawn(function()
                        executeKittyWareLoopDash(targetModel, targetModel.HumanoidRootPart)
                    end)
                end
            end
        end
    end)
end

if LocalPlayer.Character then
    setupKittyWareHooks(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupKittyWareHooks)

