-- Load the Orion UI Library
local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Orion/main/source'))()

-- Create the Main Window
local Window = OrionLib:MakeWindow({
    Name = "Solitude | Dash Helper",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "SolitudeConfig"
})

-- Create a Tab
local Tab = Window:MakeTab({
    Name = "Main Controls",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- Add a Toggle
Tab:AddToggle({
    Name = "Dash Helper Enabled",
    Default = false,
    Callback = function(Value)
        print("Dash helper toggled:", Value)
        -- Your dash helper code logic goes here
    end    
})

-- Add a Slider
Tab:AddSlider({
    Name = "Dash Delay",
    Min = 0,
    Max = 1,
    Default = 0.1,
    Color = Color3.fromRGB(255,255,255),
    Increment = 0.05,
    ValueName = "Seconds",
    Callback = function(Value)
        print("Delay set to:", Value)
        -- Your delay logic goes here
    end    
})

-- Initialize the UI
OrionLib:Init()
