    local mouse = LocalPlayer:GetMouse()
    local relativeX = math.clamp(mouse.X - delaySliderBg.AbsolutePosition.X, 0, delaySliderBg.AbsoluteSize.X)
    local percentage = relativeX / delaySliderBg.AbsoluteSize.X
    updateDelay(string.format("%.2f", 0.1 + (percentage * (2.0 - 0.1))))
end)

