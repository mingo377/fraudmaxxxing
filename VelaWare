-- ===== Background Switcher =====
local bgConn
local function resolveImage(img)
    if img:sub(1, 5) == "file:" then
        local path = img:sub(6)
        if getcustomasset and isfile and isfile(path) then
            local ok, id = pcall(getcustomasset, path); if ok then return id end
        end
        return nil
    elseif img:sub(1, 4) == "url:" then
        local url = img:sub(5)
        local h = 0
        for i = 1, #url do h = (h * 31 + url:byte(i)) % 1000000007 end
        local path = "velaware_bg_" .. h .. ".png"
        if writefile and getcustomasset and isfile then
            if not isfile(path) then
                local ok, data = pcall(game.HttpGet, game, url)
                if not ok then return nil end
                writefile(path, data)
            end
            local ok, id = pcall(getcustomasset, path); if ok then return id end
        end
        return nil
    end
    return img
end

local function applyBackground(name)
    local b
    for _, x in ipairs(BACKGROUNDS) do if x.name == name then b = x end end
    if not b or b.image == "" then return end
    local img = resolveImage(b.image)
    if not img then warn("[Velaware] couldn't load background '" .. name .. "'"); return end

    currentBgDef = b
    frameIndex = 0
    frameClock = 0
    blendBusy = false

    local newW = b.w or 341
    local newH = b.h or 213

    activeLayer.Image = img
    activeLayer.ImageTransparency = 0.06
    activeLayer.ImageRectOffset = Vector2.new(0, 0)
    activeLayer.ImageRectSize = b.cols and Vector2.new(newW, newH) or Vector2.new(0, 0)
    incomingLayer.Image = img
    incomingLayer.ImageTransparency = 1
    incomingLayer.ImageRectOffset = Vector2.new(0, 0)
    incomingLayer.ImageRectSize = b.cols and Vector2.new(newW, newH) or Vector2.new(0, 0)
end

