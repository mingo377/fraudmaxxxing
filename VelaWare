-- ===== Side/Back Dash Range =====
-- The game's dash is a BodyVelocity/LinearVelocity parented to the HumanoidRootPart.
-- Instead of listening for the Q key (breaks on mobile / when the game sinks the input),
-- we scale that velocity the moment it appears. Direction is judged relative to the camera
-- because WASD / the thumbstick are camera-relative.
local dashStates = {}
local rootChildConn

local function getDashVel(inst)
    if inst:IsA("BodyVelocity") then return inst.Velocity end
    return inst.VectorVelocity
end
local function setDashVel(inst, v)
    if inst:IsA("BodyVelocity") then inst.Velocity = v else inst.VectorVelocity = v end
end

local function classifyDash(vel)
    local cam = workspace.CurrentCamera
    if not cam then return "None" end
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
    if flat.Magnitude < 1 or look.Magnitude < 0.01 then return "None" end
    local dot = flat.Unit:Dot(look.Unit)
    if dot < -0.5 then return "Back" end
    if math.abs(dot) <= 0.5 then return "Side" end
    return "Front"
end

local function trackDashRange(inst)
    if inst:IsA("BodyVelocity") or inst:IsA("LinearVelocity") then
        dashStates[inst] = { kind = false }
    end
end

RunService.Heartbeat:Connect(function()
    if next(dashStates) == nil then return end
    local P = Settings.Player
    for inst, st in pairs(dashStates) do
        if not inst.Parent then
            dashStates[inst] = nil
        else
            local ok, cur = pcall(getDashVel, inst)
            if ok and cur then
                if st.kind == false and Vector3.new(cur.X, 0, cur.Z).Magnitude >= 1 then
                    local kind = classifyDash(cur)
                    local range
                    if kind == "Side" and P.SideDashEnabled then range = P.SideDashRange
                    elseif kind == "Back" and P.BackDashEnabled then range = P.BackDashRange end
                    if range then
                        st.kind = kind
                        st.mult = (tonumber(range) or 15) / 15
                        st.base = cur
                        if Settings.Autoblock.Debug then
                            print(string.format("[Velaware] %s dash detected, scaling x%.2f", kind, st.mult))
                        end
                    else
                        st.kind = "Skip"
                    end
                end
                if st.mult then
                    -- if the game changed the velocity itself, treat that as the new base
                    if st.last and (cur - st.last).Magnitude > 0.05 then st.base = cur end
                    local scaled = Vector3.new(st.base.X * st.mult, st.base.Y, st.base.Z * st.mult)
                    st.last = scaled
                    pcall(setDashVel, inst, scaled)
                end
            end
        end
    end
end)

-- ===== Solitude Dash (magnet) =====
-- Active when Auto Tech is ON and Tech Mode = "Solitude Dash". Triggers on the dash animation,
-- waits the Solitude delay, teleports onto the closest target, then magnet-pulls for 0.2s.
local SOLITUDE_ANIM_A, SOLITUDE_ANIM_B = "10479335397", "13380255751"
local solitudeDashVelocity
local solitudePullConn
local solitudeNpcList, solitudeLastNpcUpdate = {}, 0

local function solitudeActive()
    return Settings.AutoTech.Enabled and Settings.AutoTech.Tech == "Solitude Dash"
end

local function updateSolitudeNpcCache()
    solitudeNpcList = {}
    if not currentRootPart then return end
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
            local root = model.HumanoidRootPart
            if root ~= currentRootPart then
                table.insert(solitudeNpcList, root)
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if not solitudeActive() then return end
    if tick() - solitudeLastNpcUpdate > 0.5 then
        solitudeLastNpcUpdate = tick()
        updateSolitudeNpcCache()
    end
end)

local function solitudeClosestTarget()
    if not currentRootPart then return nil end
    local closestRoot = nil
    local shortestDistance = math.huge
    local myPos = currentRootPart.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (myPos - root.Position).Magnitude
                if dist < shortestDistance and dist > 0.1 then
                    shortestDistance = dist
                    closestRoot = root
                end
            end
        end
    end
    for _, npcRoot in ipairs(solitudeNpcList) do
        if npcRoot and npcRoot.Parent then
            local dist = (myPos - npcRoot.Position).Magnitude
            if dist < shortestDistance and dist > 0.1 then
                shortestDistance = dist
                closestRoot = npcRoot
            end
        end
    end
    return closestRoot
end

local function startSolitudePull()
    if solitudePullConn then solitudePullConn:Disconnect() end
    local startTime = tick()
    local pullDuration = 0.200
    local pullStrength = 50
    local smoothness = 0.65
    solitudePullConn = RunService.Heartbeat:Connect(function()
        if not currentRootPart or not currentRootPart.Parent then
            solitudePullConn:Disconnect()
            solitudePullConn = nil
            return
        end
        local elapsed = tick() - startTime
        if elapsed >= pullDuration then
            solitudePullConn:Disconnect()
            solitudePullConn = nil
            return
        end
        local targetRoot = solitudeClosestTarget()
        if not targetRoot then return end
        local currentPos = currentRootPart.Position
        local targetHorizontal = Vector3.new(targetRoot.Position.X, currentPos.Y, targetRoot.Position.Z)
        local direction = (targetHorizontal - currentPos)
        local distance = direction.Magnitude
        if distance > 1 then
            direction = direction.Unit
            local desiredVel = direction * pullStrength
            local currentVel = currentRootPart.AssemblyLinearVelocity
            local newVel = currentVel:Lerp(desiredVel, smoothness)
            pcall(function()
                currentRootPart.AssemblyLinearVelocity = Vector3.new(newVel.X * 0.85, currentVel.Y, newVel.Z * 0.85)
            end)
        end
    end)
end

local function doSolitudeTPAndStick()
    if not solitudeActive() then return end
    if not currentRootPart or not currentCharacter then return end
    local targetRoot = solitudeClosestTarget()
    if not targetRoot then return end
    local distance = (currentRootPart.Position - targetRoot.Position).Magnitude
    if distance > 6 then return end
    task.wait(Settings.AutoTech.SolitudeDelay)
    if not currentRootPart or not currentRootPart.Parent then return end
    local targetPos = targetRoot.Position + Vector3.new(0, 2, 0)
    pcall(function() currentRootPart.CFrame = CFrame.new(targetPos) end)
    if solitudeDashVelocity and solitudeDashVelocity.Parent then
        solitudeDashVelocity:Destroy()
        solitudeDashVelocity = nil
    end
    if currentRootPart then
        pcall(function()
            local vel = currentRootPart.AssemblyLinearVelocity
            currentRootPart.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
        end)
    end
    startSolitudePull()
end

local function trackSolitudeDash(child)
    if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") then
        solitudeDashVelocity = child
    end
end

