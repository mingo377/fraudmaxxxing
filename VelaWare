                local counter = plr.Character:FindFirstChild("Counter")
                if counter then counter:Destroy() end
            end
        end
    end)
end

-- 1 = leave the dash alone; otherwise scale by range / 15
function PlayerFx.dashMultiplier(vel)
    if not currentRootPart then return 1 end
    local flatVel = Vector3.new(vel.X, 0, vel.Z)
    if flatVel.Magnitude < 1 then return 1 end
    local cf = currentRootPart.CFrame
    local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
    local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
    if look.Magnitude < 0.001 or right.Magnitude < 0.001 then return 1 end
    local u = flatVel.Unit
    local f, r = u:Dot(look.Unit), u:Dot(right.Unit)
    if f < -0.5 then
        if Settings.Player.BackDashEnabled then return Settings.Player.BackDashRange / 15 end
    elseif math.abs(r) > 0.5 then
        if Settings.Player.SideDashEnabled then return Settings.Player.SideDashRange / 15 end
    end
    return 1
end

-- KittyWare's trigger: the game adds a "dodgevelocity" object to your character on a side/back dash;
-- 0.05s later the root velocity is scaled (skipped while animId6 is playing)
function PlayerFx.onDash()
    task.spawn(function()
        task.wait(0.05)
        if not currentRootPart or not currentHumanoid then return end
        if isAnimationPlaying(animId6, currentHumanoid) then return end
        local vel = currentRootPart.AssemblyLinearVelocity
        local mult = PlayerFx.dashMultiplier(vel)
        if mult ~= 1 then
            dbg("dash scaled x" .. string.format("%.2f", mult))
            currentRootPart.AssemblyLinearVelocity = Vector3.new(vel.X * mult, vel.Y, vel.Z * mult)
        end
    end)
end

function PlayerFx.hookDash(char)
    if PlayerFx.dashConn then PlayerFx.dashConn:Disconnect(); PlayerFx.dashConn = nil end
    if not char then return end
