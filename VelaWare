local function detectDevice()
    local ok, ten = pcall(function() return game:GetService("GuiService"):IsTenFootInterface() end)
    if ok and ten then return "Console", false end
    -- the platform is the reliable signal (touch screens on PC laptops report TouchEnabled too)
    local okp, platform = pcall(function() return UIS:GetPlatform() end)
    if okp and platform then
        if platform == Enum.Platform.IOS or platform == Enum.Platform.Android then return "Mobile", true end
        if platform == Enum.Platform.Windows or platform == Enum.Platform.OSX or platform == Enum.Platform.Linux or platform == Enum.Platform.UWP then return "PC", false end
    end
    if UIS.TouchEnabled and not UIS.KeyboardEnabled then return "Mobile", true end
    return "PC", false
end

