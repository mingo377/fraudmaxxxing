            end)
        end
        if id == "rbxassetid://" .. animId4 or id == "rbxassetid://" .. animId5 then
            local lastHit   = currentCharacter:GetAttribute("LastM1Hitted")
            local targetChar = nil
            if lastHit then
                local targetName = lastHit:match("^(.-);;")
                if targetName then targetChar = liveFolder:FindFirstChild(targetName) end
            end
            if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then
                local bestDist, bestChar = 50, nil
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= player and plr.Character then
                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        local hum = plr.Character:FindFirstChild("Humanoid")
                        if hrp and hum and hum.Health > 0 and currentRootPart then
                            local dist = (hrp.Position - currentRootPart.Position).Magnitude
                            if dist < bestDist then bestDist, bestChar = dist, plr.Character end
                        end
                    end
                end
                if bestChar then targetChar = bestChar end
            end
            if not targetChar then return end
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar:FindFirstChild("Humanoid")
            if not targetHrp or not targetHum then return end
            task.wait(math.max(0, 0.38 - pingScaledDelay(1000)))
            if Settings.AutoTech.Enabled and not isDashOnCooldown then
                local handler = TECH_HANDLERS[Settings.AutoTech.Tech]
                if handler then task.spawn(handler, targetChar, targetHrp, targetHum) end
            end
        end
    end)
end

local hookedModels = setmetatable({}, { __mode = "k" })
local function hookModel(model)
    if not model or model == player.Character or hookedModels[model] then return end
    hookedModels[model] = model.DescendantAdded:Connect(function(desc)
        if Settings.Autoblock.Enabled then task.spawn(watchEnemyModel, desc) end
    end)
    model.AncestryChanged:Connect(function(_, parent)
        if not parent and hookedModels[model] then
            hookedModels[model]:Disconnect(); hookedModels[model] = nil
        end
    end)
end

local function onPlayerAdded(plr)
    if plr == player then return end
    if plr.Character then hookModel(plr.Character) end
    hookModel(liveFolder:FindFirstChild(plr.Name))
    plr.CharacterAdded:Connect(function(char)
        hookModel(char)
        hookModel(liveFolder:FindFirstChild(plr.Name))
    end)
end
liveFolder.ChildAdded:Connect(function(child)
    if child.Name ~= player.Name and Players:FindFirstChild(child.Name) then hookModel(child) end
end)
Players.PlayerAdded:Connect(onPlayerAdded)
for _, plr in ipairs(Players:GetPlayers()) do if plr ~= player then onPlayerAdded(plr) end end

if player.Character then task.spawn(onCharacterAdded, player.Character) end
player.CharacterAdded:Connect(onCharacterAdded)

