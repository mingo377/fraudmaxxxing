-- ===== Cooldown Detector =====
local isDashOnCooldown = false
local function performFrontDash()
    if not isDashOnCooldown and currentCommunicate then
        currentCommunicate:FireServer(leftclick.frontDash)
        if not workspace:GetAttribute("NoDashCooldown") then
            isDashOnCooldown = true
            task.delay(5, function() isDashOnCooldown = false end)
        end
    end
end

local function performDashWithDelay(delay)
    performFrontDash()
    task.wait(pingScaledDelay(1000) + 0.05 + (delay or 0))
end

local function isAnimationPlaying(animId, hum)
    hum = hum or currentHumanoid
    if not hum then return false end
    local animator = hum:FindFirstChild("Animator")
    if not animator then return false end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.Animation and track.Animation.AnimationId == "rbxassetid://" .. tostring(animId) then return true end
    end
    return false
end

