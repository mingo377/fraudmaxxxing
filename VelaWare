end

local function autoblockRotateLoop(part, hum, char, dashPredicted)
    local charConn = autoblockEasingTick(part, hum)
    local startTick = tick()
    local loopConn
    loopConn = RunService.Heartbeat:Connect(function()
        fireHoldBlock()
        if char:FindFirstChild("NoBlock") or (currentRootPart.Position - part.Position).Magnitude >= Distances.Barrage + 5 then
            stopRotate(charConn)
            loopConn:Disconnect()
            fireReleaseBlock()
            return
        end
        if math.clamp((tick() - startTick) / 0.1, 0, 1) >= 1 and not char:FindFirstChild("Slowed") then
            stopRotate(charConn)
            loopConn:Disconnect()
            fireReleaseBlock()
        end
    end)
end

