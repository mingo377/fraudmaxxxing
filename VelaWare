local function isFlingTargetValid(char, ignoreSet)
    if not char then return false end
    for _, child in pairs(char:GetChildren()) do if ignoreSet[child.Name] then return false end end
    return true
end

local function angleBetweenCFrames(part)
    if not currentRootPart or not part then return 0 end
    local flatLook = Vector3.new(currentRootPart.CFrame.LookVector.X, 0, currentRootPart.CFrame.LookVector.Z)
    if flatLook.Magnitude < 0.001 then return 0 end
    local look = flatLook.Unit
    local vec = part.Position - currentRootPart.Position
    vec = Vector3.new(vec.X, 0, vec.Z)
    if vec.Magnitude == 0 then return 0 end
    return math.deg(math.acos(math.clamp(look:Dot(vec.Unit), -1, 1)))
end

local function isWithinFieldOfView(part, fov)
    return angleBetweenCFrames(part) <= (fov / 2)
end

local blockActive = false
local function fireHoldBlock() if not blockActive and currentCommunicate then blockActive = true; currentCommunicate:FireServer(leftclick.holdBlock) end end
local function fireReleaseBlock() if blockActive and currentCommunicate then blockActive = false; currentCommunicate:FireServer(leftclick.releaseBlock) end end

local function makeRotCFrame(pos, yaw, pitch)
    workspace.CurrentCamera.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

local function startSmoothRotateCamToPos(targetPos, duration)
    duration = duration or 0
    local startTick = tick()
    local startCF = workspace.CurrentCamera.CFrame
    local startPos = startCF.Position
    local targetVector = (targetPos - startPos)
    if targetVector.Magnitude < 0.1 then return end
    targetVector = targetVector.Unit
    local startYaw = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local targetYaw = math.atan2(-targetVector.X, -targetVector.Z)
    local pitch = math.asin(math.clamp(startCF.LookVector.Y, -1, 1))
    if duration <= 0 then
        makeRotCFrame(startPos, targetYaw, pitch)
        return
    end
    local name = "VelaSmoothRotateCamPos" .. tick()
    RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / duration, 0, 1)
        local alpha = t * t * (3 - 2 * t)
        local finalYaw = startYaw + (targetYaw - startYaw) * alpha
        makeRotCFrame(startPos, finalYaw, pitch)
        if t >= 1 then RunService:UnbindFromRenderStep(name) end
    end)
end

local function characterRotateEasing(part, hum, duration)
    duration = duration or 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not part.Parent or not currentRootPart or not currentRootPart.Parent or hum.Health <= 0 or currentHumanoid.Health <= 0 then
            conn:Disconnect()
            return
        end
        if isFlingTargetValid(currentRootPart.Parent, localBusySet) then
            currentHumanoid.AutoRotate = false
            local cf = currentRootPart.CFrame
            local targetPos = Vector3.new(part.Position.X, cf.Position.Y, part.Position.Z)
            local targetCF = CFrame.new(cf.Position, targetPos)
            if duration <= 0 then currentRootPart.CFrame = targetCF
            else currentRootPart.CFrame = cf:Lerp(targetCF, math.clamp(dt / duration, 0, 1)) end
        end
    end)
    return conn
end

local function stopRotate(conn)
    if conn then
        conn:Disconnect()
        if currentHumanoid then currentHumanoid.AutoRotate = true end
    end
end

local function autoblockEasingTick(part, hum)
    local conn
    if Settings.Autoblock.RotateChar then
        conn = characterRotateEasing(part, hum, Settings.Autoblock.CharEasing)
    end
    if Settings.Autoblock.RotateCam then
        startSmoothRotateCamToPos(part.Position, Settings.Autoblock.CamEasing)
    end
    return conn
end

local function dashVelocityGuard(part)
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 0.1 then return false end
    local toMe = currentRootPart.Position - part.Position
    if toMe.Magnitude < 0.01 then return false end
    return vel.Unit:Dot(toMe.Unit) > 0.7
end

local function autoCounterCast(enemyRoot, enemyHum, dashPredicted)
    local hotbar = player.PlayerGui:FindFirstChild("Hotbar")
    local backpack = hotbar and hotbar:FindFirstChild("Backpack")
    local hotbarGui = backpack and backpack:FindFirstChild("Hotbar")
    local slot4 = hotbarGui and hotbarGui:FindFirstChild("4")
    local base = slot4 and slot4:FindFirstChild("Base")
    local cooldown = base and base:FindFirstChild("Cooldown")

    if dashPredicted or cooldown or not counterTool or not Settings.Autoblock.AutoCounter then
        return true
    elseif counterTool then
        currentCommunicate:FireServer({
            IsAutoActivate = true,
            Goal = "Console Move",
            Tool = counterTool,
            ToolName = counterTool.Name,
        })
        return false
    end
    return true
end

