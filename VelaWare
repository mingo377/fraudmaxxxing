local tabTransitionSerial = 0
local function selectTab(name, instant)
    local targetData = pages[name]
    if not targetData then return end
    if not instant and currentTab == name and targetData.page.Visible and targetData.page.GroupTransparency <= 0.02 then
        return
    end
    currentTab = name
    tabTransitionSerial += 1
    local thisTransition = tabTransitionSerial

    local index = table.find(tabNames, name) or 1
    pill.Visible = true
    if instant then
        pill.Position = UDim2.fromOffset(0, (index - 1) * (TAB_H + TAB_GAP))
    else
        tween(pill, 0.30, {
            Position = UDim2.fromOffset(0, (index - 1) * (TAB_H + TAB_GAP)),
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    end
    for tabName, button in pairs(tabButtons) do
        tween(button, 0.18, {
            TextColor3 = tabName == name and Color3.new(1, 1, 1) or Color3.fromRGB(180, 190, 220),
        }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    end

    if instant then
        for tabName, data in pairs(pages) do
            data.page.Visible = tabName == name
            data.page.GroupTransparency = tabName == name and 0 or 1
            data.page.Position = UDim2.fromOffset(0, 0)
        end
        return
    end

    task.spawn(function()
        local fadeOutTweens = {}
        for tabName, data in pairs(pages) do
            if data.page.Visible and tabName ~= name then
                table.insert(fadeOutTweens, tween(data.page, 0.14, {
                    GroupTransparency = 1,
                    Position = UDim2.fromOffset(-5, 0),
                }, Enum.EasingStyle.Sine, Enum.EasingDirection.In))
            end
        end
        for _, fadeOut in ipairs(fadeOutTweens) do fadeOut.Completed:Wait() end
        if thisTransition ~= tabTransitionSerial then return end

        for tabName, data in pairs(pages) do
            if tabName ~= name then
                data.page.Visible = false
                data.page.GroupTransparency = 1
                data.page.Position = UDim2.fromOffset(0, 0)
            end
        end

        local targetPage = targetData.page
        targetPage.Visible = true
        targetPage.GroupTransparency = 1
        targetPage.Position = UDim2.fromOffset(5, 0)
        local fadeIn = tween(targetPage, 0.24, {
            GroupTransparency = 0,
            Position = UDim2.fromOffset(0, 0),
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        fadeIn.Completed:Wait()
        if thisTransition == tabTransitionSerial and targetPage.Parent then
            targetPage.GroupTransparency = 0
            targetPage.Position = UDim2.fromOffset(0, 0)
        end
    end)
end

