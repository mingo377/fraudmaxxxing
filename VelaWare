    local hotbarGui = backpack and backpack:FindFirstChild("Hotbar")
    local slot4     = hotbarGui and hotbarGui:FindFirstChild("4")
    local base      = slot4   and slot4:FindFirstChild("Base")
    local cooldown  = base    and base:FindFirstChild("Cooldown")

    if dashPredicted or cooldown or not counterTool or not Settings.Autoblock.AutoCounter then
        return true
    elseif counterTool then
        currentCommunicate:FireServer({
            IsAutoActivate = true, Goal = "Console Move",
            Tool = counterTool,    ToolName = counterTool.Name,
        })
