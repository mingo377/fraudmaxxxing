-- ===== Backgrounds =====
local bgConn
local function resolveImage(img)
    if img:sub(1, 5) == "file:" then
        local path = img:sub(6)
        if getcustomasset and isfile and isfile(path) then
            local ok, id = pcall(getcustomasset, path)
            if ok then return id end
        end
        return nil
    elseif img:sub(1, 4) == "url:" then
        local url = img:sub(5)
        local h = 0
        for i = 1, #url do h = (h * 31 + url:byte(i)) % 1000000007 end
        local path = "velaware_bg_" .. h .. ".png"
        if writefile and getcustomasset and isfile then
            if not isfile(path) then
                local ok, data = pcall(game.HttpGet, game, url)
                if not ok then return nil end
                writefile(path, data)
            end
            local ok, id = pcall(getcustomasset, path)
            if ok then return id end
        end
        return nil
    end
    return img
end

local function applyBackground(name)
    local b
    for _, x in ipairs(BACKGROUNDS) do if x.name == name then b = x end end
    if not b or b.image == "" then return end
    local img = resolveImage(b.image)
    if not img then warn("[Velaware] couldn't load background '" .. name .. "' (check the image path/link)") return end
    if bgConn then bgConn:Disconnect(); bgConn = nil end
    bg.Image = img
    if b.cols then
        bg.ImageRectSize = Vector2.new(b.w, b.h)
        bg.ImageRectOffset = Vector2.new(0, 0)
        local last = -1
        local t0 = tick()
        bgConn = RunService.Heartbeat:Connect(function()
            if not root.Visible then return end
            local i = math.floor((tick() - t0) * b.fps) % b.frames
            if i ~= last then
                last = i
                bg.ImageRectOffset = Vector2.new((i % b.cols) * b.w, math.floor(i / b.cols) * b.h)
            end
        end)
    else
        bg.ImageRectSize = Vector2.new(0, 0)
        bg.ImageRectOffset = Vector2.new(0, 0)
    end
end

