-- Korblox: ApplyDescription does nothing from a LocalScript, so swap the meshes directly (client-side).
-- R15 = swap the 3 right-leg MeshParts. R6 = add a CharacterMesh.
local korbloxOriginals = setmetatable({}, { __mode = "k" })
local korbloxApplied   = setmetatable({}, { __mode = "k" })

local function applyKorblox(char)
    if not char then return end
    local on = Settings.Player.Korblox

    -- R15
    local upper = char:FindFirstChild("RightUpperLeg")
    local lower = char:FindFirstChild("RightLowerLeg")
    local foot  = char:FindFirstChild("RightFoot")
    if upper and lower and foot and upper:IsA("MeshPart") and lower:IsA("MeshPart") and foot:IsA("MeshPart") then
        if on and not korbloxApplied[upper] then
            local ok, err = pcall(function()
                for _, part in ipairs({ upper, lower, foot }) do
                    if not korbloxOriginals[part] then
                        korbloxOriginals[part] = { mesh = part.MeshId, tex = part.TextureID, transparency = part.Transparency }
                    end
                end
                lower.MeshId = "rbxassetid://902942093"
                upper.MeshId = "rbxassetid://902942096"
                foot.MeshId  = "rbxassetid://902942089"
                upper.TextureID = "rbxassetid://902843398"
                lower.Transparency = 1
                foot.Transparency  = 1
            end)
            if ok then
                korbloxApplied[upper] = true
            else
                warn("[Velaware] Korblox: couldn't write MeshId (executor blocked it?): " .. tostring(err))
            end
        elseif (not on) and korbloxApplied[upper] then
            pcall(function()
                for _, part in ipairs({ upper, lower, foot }) do
                    local o = korbloxOriginals[part]
                    if o then
                        part.MeshId = o.mesh
                        part.TextureID = o.tex
                        part.Transparency = o.transparency
                    end
                end
            end)
            korbloxApplied[upper] = nil
        end
    end

    -- R6
    if char:FindFirstChild("Right Leg") then
        local existing = char:FindFirstChild("VelaKorblox")
        if on and not existing then
            pcall(function()
                local cm = Instance.new("CharacterMesh")
                cm.Name = "VelaKorblox"
                cm.BodyPart = Enum.BodyPart.RightLeg
                cm.MeshId = 101851696
                cm.OverlayTextureId = 101851254
                cm.Parent = char
            end)
        elseif (not on) and existing then
            existing:Destroy()
        end
    end
end

