local function watchEnemyModel(desc)
    if not desc or not Settings.Autoblock.Enabled then return end
    local name = desc.Name
    local isM1ing = name == "M1ing"
    local isInterrupt = interruptMovesSet[name]
    local isBarrage = barrageMovesSet[name]
    if not (isM1ing or isInterrupt or isBarrage) then return end

    if not currentRootPart or not currentCharacter or not currentHumanoid or not currentCommunicate then return end
    local model = desc:FindFirstAncestorWhichIsA("Model") or (desc.Parent and desc.Parent:FindFirstAncestorWhichIsA("Model"))
    if model and not model:FindFirstChild("HumanoidRootPart") then
        local p = model.Parent
        while p and p ~= workspace do
            if p:IsA("Model") and p:FindFirstChild("HumanoidRootPart") then model = p; break end
            p = p.Parent
        end
    end
    if not model or model == currentCharacter then return end
    local enemyHum = model:FindFirstChild("Humanoid")
    local enemyRoot = model:FindFirstChild("HumanoidRootPart")
    if not enemyHum or not enemyRoot then return end
    if currentHumanoid.Health <= 0 or enemyHum.Health <= 0 then return end

    local m1Range = Settings.Autoblock.Range or 9
    local dist = (currentRootPart.Position - enemyRoot.Position).Magnitude
    dbg(string.format("%s from %s | dist %.1f", name, model.Name, dist))
    local isMovingM1 = dist <= (m1Range + 6) and dashVelocityGuard(enemyRoot)
    local isDashPredicted = Settings.Autoblock.DashPredict and (isAnimationPlaying(animId3, enemyHum) or isAnimationPlaying(animId2, enemyHum)) and dist <= (m1Range + 19)
    if not (dist <= m1Range or isMovingM1 or isDashPredicted) then dbg("skip: out of range") return end
    if not isFlingTargetValid(currentCharacter, localBusySet) then dbg("skip: you are busy (" .. busyNames(currentCharacter, localBusySet) .. ")") return end
    if not isFlingTargetValid(model, enemyBusySet) then dbg("skip: enemy busy (" .. busyNames(model, enemyBusySet) .. ")") return end
    if not isWithinFieldOfView(enemyRoot, Settings.Autoblock.FOV) then dbg("skip: outside FOV") return end
    if not autoCounterCast(enemyRoot, enemyHum, isMovingM1) then dbg("auto counter used instead of block") return end

    if isM1ing then autoblockDistanceState(enemyRoot, enemyHum, isDashPredicted)
    elseif isInterrupt then autoblockDistanceState(enemyRoot, enemyHum, isDashPredicted)
    elseif isBarrage then autoblockRotateLoop(enemyRoot, enemyHum, model, isDashPredicted) end
end

-- ===== KittyWare Tech Math =====
-- hardened version: camera nil check, precision clamp, zero-length guard, asin clamp.
-- (character/camera rotation rules are the original ones: lockChar rotates the character,
--  the camera only rotates when lockChar is false or rotateCam is true)
local function computeLockAngles(angle, targetPos, lockChar, rotateCam, precision)
    if not currentRootPart or not currentHumanoid then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    precision = math.clamp(tonumber(precision) or 1, 0, 1)

    local camCF = camera.CFrame
    local camPos = camCF.Position
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
        camPos = camPos - camCF.RightVector * 1.75
    end

    local look = lockChar and currentRootPart.CFrame.LookVector or camCF.LookVector
    local currentYaw = math.atan2(-look.X, -look.Z)
    local targetYaw
    if targetPos then
        local origin = lockChar and currentRootPart.Position or camPos
        local direction = targetPos - origin
        if direction.Magnitude < 0.001 then return end
        targetYaw = math.atan2(-direction.X, -direction.Z)
    else
        targetYaw = currentYaw + math.rad(tonumber(angle) or 0)
    end

    local diff = math.atan2(math.sin(targetYaw - currentYaw), math.cos(targetYaw - currentYaw))
    local finalYaw = currentYaw + diff * precision

    local doChar = lockChar or rotateCam
    local doCam = (not lockChar) or rotateCam

    if doChar then
        currentHumanoid.AutoRotate = false
        currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
    end
    if doCam then
        makeRotCFrame(camCF.Position, finalYaw, math.asin(math.clamp(camCF.LookVector.Y, -1, 1)))
    end
end

local function startSmoothRotateCamera(angle, duration, rotateChar)
    local startTick = tick()
    local startCF = rotateChar and currentRootPart.CFrame or workspace.CurrentCamera.CFrame
    local startYaw = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local targetYaw = startYaw + math.rad(angle)
    local name = "VelaSmoothRotate" .. tick()

    RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / duration, 0, 1)
        local alpha = t * t * (3 - 2 * t)
        local camCF = workspace.CurrentCamera.CFrame
        local finalYaw = startYaw + (targetYaw - startYaw) * alpha
        if rotateChar then
            currentHumanoid.AutoRotate = false
            currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        else
            makeRotCFrame(camCF.Position, finalYaw, math.asin(math.clamp(camCF.LookVector.Y, -1, 1)))
        end
        if t >= 1 then RunService:UnbindFromRenderStep(name) end
    end)
end

local function ragdollHealthWatcher(method, duration, targetChar, targetHum, callback)
    local conn
    conn = RunService[method]:Connect(function()
        if not targetChar or targetChar:FindFirstChild("BeingLaunched") or not targetChar:FindFirstChild("Ragdoll") or not targetHum or targetHum.Health <= 0 or not currentHumanoid or currentHumanoid.Health <= 0 then
            if conn then conn:Disconnect() end
            return
        end
        callback()
    end)
    task.wait(duration)
    if conn then conn:Disconnect() end
    if currentHumanoid then currentHumanoid.AutoRotate = true end
end

local function isTargetAbove(targetHRP)
    local myPos = currentRootPart.Position
    local targetPos = targetHRP.Position
    local horizontalDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
    if horizontalDist <= 0.2 and myPos.Y < targetPos.Y then
        return true
    end
    return false
end

local function doTechSupa(target, hrp, hum)
    performDashWithDelay()
    local offset = hrp.CFrame:PointToObjectSpace(currentRootPart.Position)
    ragdollHealthWatcher("Heartbeat", 0.3, target, hum, function()
        local worldPos = hrp.CFrame:PointToWorldSpace(offset)
        currentCharacter:PivotTo(CFrame.lookAt(worldPos, Vector3.new(hrp.Position.X, worldPos.Y + 1.5, hrp.Position.Z), Vector3.new(0, 1, 0)))
    end)
end

local function doTechLockOn(target, hrp, hum)
    performDashWithDelay()
    ragdollHealthWatcher("Heartbeat", 0.7, target, hum, function()
        computeLockAngles(nil, hrp.Position, true, false, Settings.AutoTech.LockonPrecision)
    end)
end

local function doTechLoopDash(target, hrp, hum)
    performDashWithDelay()
    computeLockAngles(90, nil, true)
    startSmoothRotateCamera(270, 0.35, false)
    task.wait(0.3)
    local cachedCF = nil
    ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
        if cachedCF or isTargetAbove(hrp) then
            if not cachedCF then
                cachedCF = currentRootPart.CFrame
            end
            currentCharacter:PivotTo(cachedCF)
        else
            computeLockAngles(nil, hrp.Position, true)
        end
    end)
end

local function doTechKiba(target, hrp, hum)
    performDashWithDelay()
    ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
        currentCharacter:PivotTo(CFrame.new(hrp.Position - Vector3.new(0, 3, 2), hrp.Position))
    end)
end

local function doTechLoopV2(target, hrp, hum)
    local c = Settings.AutoTech.Loopv2
    if c.Jump then
        currentRootPart.AssemblyLinearVelocity = Vector3.new(currentRootPart.AssemblyLinearVelocity.X, 50, currentRootPart.AssemblyLinearVelocity.Z)
    end
    computeLockAngles(c.FirstFlickAngle, nil, true, c.RotateCam)
    performDashWithDelay(c.SecondFlick)
    ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
        computeLockAngles(nil, hrp.Position, true, c.RotateCam, c.Precision)
    end)
    if currentHumanoid then currentHumanoid.AutoRotate = true end
end

